{
  "mcpServers": {
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp"
    },
    "rsv-data": {
      "type": "http",
      "url": "http://localhost/UT_Demo/hs/rsvdata/mcp",
      "headers": {
        "Authorization": "Basic ${RSV_DATA_TOKEN}"
      }
    },
    "magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "${TWENTYFIRST_API_KEY}"
      }
    }
  }
}